    <name>01 Table d'orientation de Montalric</name>
    <cmt>Vue sur la plaine depuis la table d'orientation de Montalric (789 m)</cmt>
    <desc>Vue sur la plaine depuis la table d'orientation de Montalric (789 m)</desc>
  </wpt>
