    <ele>278.7</ele>
    <time>2024-03-01T13:32:25Z</time>
    <name>03 Croisement La jasse</name>
    <cmt>suivre sur la droite</cmt>
    <desc>suivre sur la droite</desc>
  </wpt>
  <wpt lat="43.453424" lon="2.186441">
    <ele>803.0</ele>
    <time>2024-03-01T13:35:09Z</time>
    <name>04 Flaques</name>
    <cmt>Même les pistes gravillonnées comme celle-ci sont très boueuses en cette saison.</cmt>
    <desc>Même les pistes gravillonnées comme celle-ci sont très boueuses en cette saison.</desc>
  </wpt>
