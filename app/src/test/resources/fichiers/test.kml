			</Point>
		</Placemark>
		<Placemark>
			<name>04 Flaques</name>
			<description>Même les pistes gravillonnées comme celle-ci sont très boueuses en cette saison.</description>
			<TimeStamp><when>2024-03-01T13:35:09Z</when>
</TimeStamp>
			<styleUrl>#waypoint</styleUrl>
			<Point>
				<coordinates>2.186441,43.453424,802.9999999999999</coordinates>
			</Point>
		</Placemark>
		<Placemark>
			<name>05 Croisement Lestelas</name>
