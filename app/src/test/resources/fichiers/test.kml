			<Point>
				<coordinates>2.1416,43.445333,278.7</coordinates>
			</Point>
		</Placemark>
		<Placemark>
			<name>02 Croix des Fangasses</name>
			<description>Croisement de la croix des Fangasses où l&apos;on trouve une cabane de chasseurs. Il est possible de venir jusqu&apos;ici en voiture pour démarrer un parcours</description>
			<TimeStamp><when>2024-03-03T07:30:54Z</when>
</TimeStamp>
			<styleUrl>#waypoint</styleUrl>
			<Point>
				<coordinates>2.166767,43.456183,278.7</coordinates>
			</Point>
		</Placemark>
