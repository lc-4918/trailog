	<Folder>
		<name>Waypoints</name>
		<Placemark>
			<name>01 Table d&apos;orientation de Montalric</name>
			<description>Vue sur la plaine depuis la table d&apos;orientation de Montalric (789 m)</description>
			<TimeStamp><when>2024-03-03T07:29:32Z</when>
</TimeStamp>
